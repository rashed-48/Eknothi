# ---- Agent model (OpenAI-compatible endpoint) ----
# Now: a stand-in Llama endpoint (Groq / Together / OpenRouter / local Ollama at http://localhost:11434/v1).
# Final: Muse Spark Open on Baseten (model meta-models/muse-spark-open-1026) or the Meta Model API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Document reading (vision). Empty = use the agent settings above ----
# Final: Muse Spark via Meta Model API
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ---- Voice notes (speech to text). ASR_MODEL must be set for voice ----
# Final: Muse Voice Transcribe via Meta Model API
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

# ---- WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; enter the same value in the webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

PUBLIC_BASE_URL=http://localhost:8000
